{
  "name": "@agentrans/web-frontend",
  "description": "Web application entry: vite build over the @agentrans/client-web shell library; dist/ served by apps/cli's agentrans web",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @agentrans/experimental-webworker-runtime exec tsdown && pnpm --filter @agentrans/experimental-webworker-packer exec tsdown && vite build && dsh-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1",
    "render:app-icons": "tsx scripts/render-app-icons.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@agentrans/cordis-plugin-group": "workspace:~",
    "@agentrans/client-modules": "workspace:*",
    "@agentrans/client-store": "workspace:*",
    "@agentrans/llm-mock-server": "workspace:*",
    "@agentrans/client-test-runtime": "workspace:*",
    "@agentrans/client-ui-deliverables": "workspace:*",
    "@agentrans/client-ui-dockkit": "workspace:*",
    "@agentrans/client-ui-primitives": "workspace:*",
    "@agentrans/client-ui-slots": "workspace:*",
    "@agentrans/client-web": "workspace:*",
    "@agentrans/cmdline": "workspace:*",
    "@agentrans/pwsh-local": "workspace:*",
    "@agentrans/experimental-agent-team": "workspace:*",
    "@agentrans/experimental-webworker-packer": "workspace:*",
    "@agentrans/experimental-webworker-runtime": "workspace:*",
    "@agentrans/remote-mock": "workspace:*",
    "@agentrans/session-projection-cache": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "8.21.3",
    "@agentrans/client-ui-theme": "workspace:*",
    "@agentrans/launch-environment": "workspace:*",
    "@agentrans/workspace-changes": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/experimental-auto-review": "workspace:*",
    "@agentrans/experimental-speech-to-text": "workspace:*",
    "@agentrans/experimental-voice-input-bundle": "workspace:*",
    "@agentrans/experimental-cot-translation-bundle": "workspace:*",
    "@agentrans/experimental-worktree": "workspace:*",
    "@agentrans/experimental-plugin-market-bundle": "workspace:*",
    "@agentrans/experimental-forge-bundle": "workspace:*"
  },
  "dependencies": {
    "@agentrans/message-quotes": "workspace:*"
  }
}
