# Copy to test.env; paths in secret configuration resolve beside macos-signing.env.
AGENTRANS_DESKTOP_APP_ID=com.deepseek.dsh
# Generate a 32-character lowercase hexadecimal release ID; retain it for upgrade testing.
AGENTRANS_DESKTOP_MACOS_PACK_CONCURRENCY=4
AGENTRANS_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
AGENTRANS_DESKTOP_MACOS_DOWNLOAD_PROXY=
# Temporarily changes the active network service's system HTTP/HTTPS proxies.
AGENTRANS_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# AGENTRANS_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
