# Copy to production.env in the same machine configuration directory and fill in the values.
AGENTRANS_DESKTOP_APP_ID=com.deepseek.dsh
# AGENTRANS_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
AGENTRANS_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
AGENTRANS_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
