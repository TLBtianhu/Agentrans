{
  "name": "@agentrans/artifact-followup",
  "description": "Host-validated experimental context attached to ordinary questions",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/artifact/artifact-followup"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentrans/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/api-session-controller": "workspace:*",
    "@agentrans/artifact": "workspace:*",
    "@agentrans/artifact-runtime": "workspace:*",
    "@agentrans/brand": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/storage-domain": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/util-values": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/api-session-controller": "workspace:*",
    "@agentrans/artifact": "workspace:*",
    "@agentrans/artifact-runtime": "workspace:*",
    "@agentrans/brand": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-format": "workspace:*",
    "@agentrans/session-format-v3-to-v4": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/storage": "workspace:*",
    "@agentrans/storage-domain": "workspace:*",
    "@agentrans/storage-json": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/util-values": "workspace:*"
  }
}
