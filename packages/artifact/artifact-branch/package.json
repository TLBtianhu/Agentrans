{
  "name": "@agentrans/artifact-branch",
  "description": "Confirmed manual-branch conclusions with saved Artifact evidence",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/artifact/artifact-branch"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/types/index.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/types/**/*.js", "lib/types/**/*.d.ts", "lib/typert.host.js", "lib/typert.host.d.ts",
    "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"],
  "license": "MIT",
  "dependencies": { "@agentrans/schemastery": "workspace:~" },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/api-session-controller": "workspace:*",
    "@agentrans/artifact": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-branch": "workspace:*",
    "@agentrans/session-query": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/api-session-controller": "workspace:*",
    "@agentrans/artifact": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-branch": "workspace:*",
    "@agentrans/session-format": "workspace:*",
    "@agentrans/session-format-v3-to-v4": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/session-query": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*"
  }
}
