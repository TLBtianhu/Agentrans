{
  "name": "@deepseek-ai/dsh-artifact",
  "description": "Session-backed interactive HTML and SceneSpec artifacts and their model-facing tools",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/artifact/artifact"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/types/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./scene": {
      "types": "./lib/types/scene.d.ts",
      "default": "./lib/scene.js"
    },
    "./particle-runtime": {
      "types": "./lib/types/particle-runtime.d.ts",
      "default": "./lib/particle-runtime.js"
    },
    "./capabilities": {
      "types": "./lib/types/capabilities.d.ts",
      "default": "./lib/capabilities.js"
    },
    "./runtime-values": {
      "types": "./lib/types/runtime-values.d.ts",
      "default": "./lib/runtime-values.js"
    },
    "./observation-comparison": {
      "types": "./lib/types/observation-comparison.d.ts",
      "default": "./lib/observation-comparison.js"
    },
    "./scene-export": {
      "types": "./lib/types/scene-export.d.ts",
      "default": "./lib/scene-export.js"
    },
    "./scene-renderers": {
      "types": "./lib/types/scene-renderers.d.ts",
      "default": "./lib/scene-renderers.js"
    },
    "./scene-tool": {
      "types": "./lib/types/scene-tool.d.ts",
      "default": "./lib/scene-tool.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/tool.js",
    "lib/scene.js",
    "lib/particle-runtime.js",
    "lib/capabilities.js",
    "lib/runtime-values.js",
    "lib/observation-comparison.js",
    "lib/scene-export.js",
    "lib/scene-renderers.js",
    "lib/scene-tool.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-input": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-format": "workspace:*",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "workspace:*",
    "@deepseek-ai/dsh-session-input": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-tool-testkit": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*"
  }
}
