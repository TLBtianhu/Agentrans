{
  "name": "@agentrans/artifact-runtime",
  "description": "Source-bound live Artifact runtime reports and model inspection",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/artifact/artifact-runtime" },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/types/index.js" },
    "./tool": { "types": "./lib/types/tool.d.ts", "default": "./lib/types/tool.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/types/**/*.js", "lib/types/**/*.d.ts", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"],
  "license": "MIT",
  "dependencies": { "@agentrans/schemastery": "workspace:~", "zod": "4.4.3" },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/artifact": "workspace:*",
    "@agentrans/brand": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/api-gateway": "workspace:*",
    "@agentrans/api-remote-access": "workspace:*",
    "@agentrans/artifact": "workspace:*",
    "@agentrans/brand": "workspace:*",
    "@agentrans/client-connection": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/typert-registry": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*"
  }
}
