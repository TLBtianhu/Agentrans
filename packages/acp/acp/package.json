{
  "name": "@agentrans/acp",
  "description": "Automation-only Agent Client Protocol server for driving DeepSeek Harness agents over JSON-RPC stdio",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@agentrans/brand": "workspace:*",
    "@agentrans/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/mcp-client": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-persistence": "workspace:*",
    "@agentrans/token-meter": "workspace:*",
    "@agentrans/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@agentrans/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/mcp-client": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-persistence": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/token-meter": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/user-approval": "workspace:*"
  }
}
