{
  "name": "@agentrans/workspace-changes",
  "description": "Per-turn workspace file changes recorded from git working-tree snapshots and whole-file captures, with per-file comparisons, for the DeepSeek Harness",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/deliverables/workspace-changes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@agentrans/schemastery": "workspace:~",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/fs": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-include": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-fs": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tool-str-replace-editor": "workspace:*",
    "@agentrans/fs-observation-policy": "workspace:*",
    "@agentrans/system-prompt": "workspace:*"
  }
}
