{
  "name": "@agentrans/experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "cua-helper.json",
    "native/Package.swift",
    "native/Info.plist",
    "native/DSHComputerUse.icns",
    "native/build_app.py",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/LICENSE.computer-use-icon",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/computer-use": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/agent": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@agentrans/atomic-write": "workspace:*",
    "@agentrans/cua": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-include": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/attachment-local": "workspace:*",
    "@agentrans/computer-use": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-executor-ptc": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/llm-deepseek": "workspace:*",
    "@agentrans/ptc-runtime-node": "workspace:*",
    "@agentrans/sandbox-local": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@agentrans/ptc-runtime": "workspace:*",
    "@agentrans/user-questions": "workspace:*",
    "@agentrans/settings": "workspace:*",
    "@agentrans/app-boot": "workspace:*",
    "@agentrans/config-editor": "workspace:*",
    "@agentrans/hmr": "workspace:*",
    "@agentrans/cordis-plugin-timer": "workspace:~",
    "@agentrans/storage": "workspace:*",
    "@agentrans/storage-json": "workspace:*",
    "@agentrans/storage-domain": "workspace:*"
  },
  "scripts": {
    "build:native": "xcrun python3 native/build_app.py",
    "build:icon": "node native/generate_icon.mjs"
  },
  "os": [
    "darwin"
  ]
}
