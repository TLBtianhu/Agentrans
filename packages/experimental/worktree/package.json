{
  "name": "@agentrans/experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@agentrans/schemastery": "workspace:~",
    "@agentrans/timeout": "workspace:*"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/sandbox": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/sandbox": "workspace:*",
    "@agentrans/sandbox-local": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  }
}
