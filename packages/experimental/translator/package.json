{
  "name": "@agentrans/experimental-translator",
  "description": "Machine translation with reusable Session results",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/translator"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentrans/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-persistence": "workspace:*",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/llm": "workspace:*",
    "@agentrans/credentials": "workspace:*",
    "@agentrans/launch-environment": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/app-boot": "workspace:*",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-persistence": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/credentials": "workspace:*",
    "@agentrans/launch-environment": "workspace:*",
    "@agentrans/llm-deepseek": "workspace:*",
    "@agentrans/llm-deepseek-api-key": "workspace:*",
    "@agentrans/llm-deepseek-account": "workspace:*",
    "@agentrans/deepseek-account": "workspace:*",
    "@agentrans/deepseek-llm-api-extensions": "workspace:*",
    "@agentrans/session-log-deepseek": "workspace:*",
    "@agentrans/session-query-sqlite": "workspace:*"
  }
}
