{
  "name": "@agentrans/experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on DeepSeek Harness extension points",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentrans/util-crypto": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/commands": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/storage-domain": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/token-meter": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/user-questions": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-include": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/commands": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/storage": "workspace:*",
    "@agentrans/storage-domain": "workspace:*",
    "@agentrans/storage-json": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/token-meter": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/user-questions": "workspace:*",
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*"
  }
}
