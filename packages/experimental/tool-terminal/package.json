{
  "name": "@agentrans/tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentrans/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/terminal": "workspace:*",
    "@agentrans/output-retention": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/jobs": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis-plugin-include": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/terminal": "workspace:*",
    "@agentrans/terminal-bash": "workspace:*",
    "@agentrans/output-retention": "workspace:*",
    "@agentrans/sandbox": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/jobs": "workspace:*",
    "@agentrans/jobs-local": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-executor-ptc": "workspace:*",
    "@agentrans/tool-jobs": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  }
}
