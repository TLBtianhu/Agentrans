{
  "name": "@agentrans/experimental-tool-agent-team",
  "description": "Scoped model-facing Agent Teams tools over ctx.agentTeams",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/tool-agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentrans/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/experimental-agent-team": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*",
    "@agentrans/session-query": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/subagent-fork-in-process": "workspace:*",
    "@agentrans/subagent-spawn-in-process": "workspace:*",
    "@agentrans/tool-subagent-control": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/experimental-agent-team": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/llm": "workspace:*",
    "@agentrans/llm-deepseek": "workspace:*"
  }
}
