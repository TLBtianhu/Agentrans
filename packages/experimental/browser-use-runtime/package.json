{
  "name": "@agentrans/experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/browser-use": "workspace:*",
    "@agentrans/mcp-client": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  },
  "dependencies": {
    "@agentrans/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/browser-use": "workspace:*",
    "@agentrans/mcp-client": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-executor-ptc": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/mcp-resources": "workspace:*",
    "@agentrans/ptc-runtime": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/cordis-plugin-include": "workspace:~",
    "@agentrans/attachment-local": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*",
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/fs-local": "workspace:*"
  }
}
