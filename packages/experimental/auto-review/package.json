{
  "name": "@agentrans/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the DeepSeek Harness Auto permission preset",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-instructions": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/permission-presets": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/working-directory": "workspace:*"
  },
  "dependencies": {
    "@agentrans/util-values": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-instructions": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/bash-sandbox": "workspace:*",
    "@agentrans/compaction": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/fs-observation-policy": "workspace:*",
    "@agentrans/fs-sandbox": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/llm-deepseek": "workspace:*",
    "@agentrans/llm-deepseek-api-key": "workspace:*",
    "@agentrans/permission-presets": "workspace:*",
    "@agentrans/ptc-runtime-node": "workspace:*",
    "@agentrans/sandbox": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/shell": "workspace:*",
    "@agentrans/shell-env": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tool-bash": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-executor-ptc": "workspace:*",
    "@agentrans/tool-fs": "workspace:*",
    "@agentrans/tool-subagent": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/user-approval": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
