{
  "name": "@agentrans/hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the DeepSeek Harness interception seams",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentrans/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/hook-protocol": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/shell": "workspace:*",
    "@agentrans/bash-local": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/hook-protocol": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  }
}
