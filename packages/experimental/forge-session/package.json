{
  "name": "@agentrans/experimental-forge-session",
  "description": "Binds change requests to the Session that created, pushed, or tracked them",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/forge-session"
  },
  "dependencies": {
    "@agentrans/timeout": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/schemastery": "workspace:~",
    "shell-quote": "^1.12.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/experimental-forge": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/shell": "workspace:*",
    "@agentrans/shell-env": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-include": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/bash-local": "workspace:*",
    "@agentrans/experimental-forge": "workspace:*",
    "@agentrans/experimental-forge-github": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/shell-env": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tool-bash": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/shell": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@agentrans/shell": {
      "optional": true
    },
    "@agentrans/shell-env": {
      "optional": true
    },
    "@agentrans/tools": {
      "optional": true
    },
    "@agentrans/sandbox-policy": {
      "optional": true
    }
  }
}
