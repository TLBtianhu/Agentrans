{
  "name": "@agentrans/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "agentrans": {
    "client": {
      "external": [
        "@agentrans/api-gateway/client"
      ],
      "inject": [
        "@agentrans/api-gateway",
        "@agentrans/client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentrans/brand": "workspace:*",
    "@agentrans/deque": "workspace:*",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-default-model": "workspace:*",
    "@agentrans/agent-preset-registry": "workspace:*",
    "@agentrans/api-gateway": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/client-connection": "workspace:*",
    "@agentrans/client-file-upload": "workspace:*",
    "@agentrans/commands": "workspace:*",
    "@agentrans/credentials": "workspace:*",
    "@agentrans/file-reference": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/native-command": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-branch": "workspace:*",
    "@agentrans/session-persistence": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/session-projection-cache": "workspace:*",
    "@agentrans/session-query": "workspace:*",
    "@agentrans/session-title": "workspace:*",
    "@agentrans/settings": "workspace:*",
    "@agentrans/skill": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/typert-registry": "workspace:*",
    "@agentrans/util-time": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/util-workspace-path": "workspace:*",
    "@agentrans/workspace": "workspace:*",
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/session-input": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@agentrans/session-persistence": {
      "optional": true
    },
    "@agentrans/session-projection-cache": {
      "optional": true
    },
    "@agentrans/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentrans/api-remote-access": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-default-model": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/agent-preset-registry": "workspace:*",
    "@agentrans/api-gateway": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/attachment-local": "workspace:*",
    "@agentrans/client-connection": "workspace:*",
    "@agentrans/client-file-upload": "workspace:*",
    "@agentrans/client-store": "workspace:*",
    "@agentrans/client-test-runtime": "workspace:*",
    "@agentrans/commands": "workspace:*",
    "@agentrans/credentials": "workspace:*",
    "@agentrans/file-reference": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/native-command": "workspace:*",
    "@agentrans/permission-presets": "workspace:*",
    "@agentrans/remote-mock": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-branch": "workspace:*",
    "@agentrans/session-persistence": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/session-projection-cache": "workspace:*",
    "@agentrans/session-query": "workspace:*",
    "@agentrans/session-title": "workspace:*",
    "@agentrans/settings": "workspace:*",
    "@agentrans/skill": "workspace:*",
    "@agentrans/storage": "workspace:*",
    "@agentrans/storage-domain": "workspace:*",
    "@agentrans/storage-json": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/typert-registry": "workspace:*",
    "@agentrans/util-crypto": "workspace:*",
    "@agentrans/util-time": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/util-workspace-path": "workspace:*",
    "@agentrans/workspace": "workspace:*",
    "@types/mime-types": "^3.0.1",
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/session-input": "workspace:*"
  }
}
