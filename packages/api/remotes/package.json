{
  "name": "@agentrans/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@agentrans/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@agentrans/deque": "workspace:*",
    "@agentrans/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/scope": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-preset-registry": "workspace:*",
    "@agentrans/artifact": "workspace:*",
    "@agentrans/artifact-branch": "workspace:*",
    "@agentrans/api-gateway": "workspace:*",
    "@agentrans/api-job-controller": "workspace:*",
    "@agentrans/api-session-controller": "workspace:*",
    "@agentrans/api-settings-controller": "workspace:*",
    "@agentrans/api-workspace-controller": "workspace:*",
    "@agentrans/api-workspace-files": "workspace:*",
    "@agentrans/client-connection": "workspace:*",
    "@agentrans/client-file-upload": "workspace:*",
    "@agentrans/commands": "workspace:*",
    "@agentrans/cordis-host-runner": "workspace:*",
    "@agentrans/credentials": "workspace:*",
    "@agentrans/file-reference": "workspace:*",
    "@agentrans/goal": "workspace:*",
    "@agentrans/host-plugin-inventory": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/message-feedback": "workspace:*",
    "@agentrans/permission-presets": "workspace:*",
    "@agentrans/schedule": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-reference": "workspace:*",
    "@agentrans/settings": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/user-approval": "workspace:*",
    "@agentrans/user-questions": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "zod": "4.4.3",
    "@agentrans/command-feedback": "workspace:*",
    "@agentrans/api-terminal-controller": "workspace:*",
    "@agentrans/plugin-manager": "workspace:*",
    "@agentrans/plugin-market": "workspace:*",
    "@agentrans/client-ui-plugin-manager": "workspace:*",
    "@agentrans/office-to-pdf": "workspace:*",
    "@agentrans/deepseek-account": "workspace:*",
    "@agentrans/client-product-analytics": "workspace:*",
    "@agentrans/client-ui-trajectory": "workspace:*",
    "@agentrans/artifact-export": "workspace:*",
    "@agentrans/artifact-runtime": "workspace:*"
  }
}
