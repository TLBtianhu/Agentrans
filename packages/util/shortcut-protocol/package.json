{
  "name": "@agentrans/shortcut-protocol",
  "description": "Physical-key and versioned shortcut preference protocol shared by the Client and the Desktop main process",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/util/shortcut-protocol"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@agentrans/brand": "workspace:*",
    "@agentrans/util-crypto": "workspace:*",
    "@agentrans/util-values": "workspace:*"
  }
}
