{
  "name": "@agentrans/client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "agentrans": {
    "client": {
      "inject": [
        "@agentrans/api-remote-access",
        "@agentrans/api-remotes",
        "@agentrans/api-session-controller",
        "@agentrans/api-workspace-controller",
        "@agentrans/client-connection",
        "@agentrans/client-locale",
        "@agentrans/client-shortcuts",
        "@agentrans/client-ui-conversation",
        "@agentrans/client-ui-layout",
        "@agentrans/client-ui-renderer",
        "@agentrans/client-ui-session",
        "@agentrans/client-ui-sidebar",
        "@agentrans/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/api-remote-access": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/api-remotes": "workspace:*",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-preset-registry": "workspace:*",
    "@agentrans/api-session-controller": "workspace:*",
    "@agentrans/api-workspace-controller": "workspace:*",
    "@agentrans/client-connection": "workspace:*",
    "@agentrans/client-locale": "workspace:*",
    "@agentrans/client-store": "workspace:*",
    "@agentrans/client-test-runtime": "workspace:*",
    "@agentrans/client-ui-conversation": "workspace:*",
    "@agentrans/client-ui-layout": "workspace:*",
    "@agentrans/client-ui-primitives": "workspace:*",
    "@agentrans/client-ui-renderer": "workspace:*",
    "@agentrans/client-ui-session": "workspace:*",
    "@agentrans/client-ui-sidebar": "workspace:*",
    "@agentrans/client-ui-slots": "workspace:*",
    "@agentrans/jobs": "workspace:*",
    "@agentrans/schedule": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/util-workspace-path": "workspace:*",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "@agentrans/client-shortcuts": "workspace:*",
    "@agentrans/client-product-analytics": "workspace:*",
    "@agentrans/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
