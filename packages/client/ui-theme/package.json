{
  "name": "@agentrans/client-ui-theme",
  "description": "Theme plugin: Host bootstrap for the pre-plugin palette; ThemeRuntime for light/dark/system state and icon replacements; --dsw-* token styles and Appearance settings row",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-theme"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./brand-font.css": "./lib/styles/brand-font.css",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@agentrans/client-connection",
        "@agentrans/client-locale",
        "@agentrans/client-shortcuts",
        "@agentrans/client-ui-renderer",
        "@agentrans/client-ui-settings",
        "@agentrans/api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/api-remotes": "workspace:*",
    "@agentrans/client-connection": "workspace:*",
    "@agentrans/client-locale": "workspace:*",
    "@agentrans/client-shortcuts": "workspace:*",
    "@agentrans/shortcut-protocol": "workspace:*",
    "@agentrans/client-store": "workspace:*",
    "@agentrans/client-test-runtime": "workspace:*",
    "@agentrans/client-ui-primitives": "workspace:*",
    "@agentrans/client-ui-renderer": "workspace:*",
    "@agentrans/client-ui-settings": "workspace:*",
    "@agentrans/client-ui-slots": "workspace:*",
    "@agentrans/host-webserver": "workspace:*",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "@agentrans/settings": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/styles",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@agentrans/schemastery": "workspace:~"
  }
}
