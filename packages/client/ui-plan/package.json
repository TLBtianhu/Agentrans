{
  "name": "@agentrans/client-ui-plan",
  "description": "Plan mode controls, persistent transcript plan cards, and sidebar Markdown previews",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-plan"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "agentrans": {
    "client": {
      "inject": [
        "@agentrans/api-remotes",
        "@agentrans/client-locale",
        "@agentrans/client-ui-conversation",
        "@agentrans/client-ui-sidebar-right",
        "@agentrans/client-ui-chat",
        "@agentrans/client-ui-user-questions",
        "@agentrans/client-resources",
        "@agentrans/api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/client-store": "workspace:*",
    "@agentrans/api-remotes": "workspace:*",
    "@agentrans/client-locale": "workspace:*",
    "@agentrans/client-test-runtime": "workspace:*",
    "@agentrans/client-ui-conversation": "workspace:*",
    "@agentrans/client-ui-primitives": "workspace:*",
    "@agentrans/client-ui-slots": "workspace:*",
    "@agentrans/plan-mode": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "react": "^18.2.0",
    "@agentrans/session": "workspace:*",
    "@agentrans/client-ui-renderer": "workspace:*",
    "@agentrans/client-ui-session": "workspace:*",
    "@agentrans/api-session-controller": "workspace:*",
    "@agentrans/client-ui-chat": "workspace:*",
    "@agentrans/client-ui-sidebar-right": "workspace:*",
    "@agentrans/client-ui-user-questions": "workspace:*",
    "@agentrans/client-resources": "workspace:*",
    "@agentrans/tool-executor-ptc": "workspace:*",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/util-crypto": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
