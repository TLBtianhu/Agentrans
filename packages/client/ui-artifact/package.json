{
  "name": "@agentrans/client-ui-artifact",
  "description": "Isolated HTML artifact Conversation cards with explicitly confirmed Agent actions",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-artifact"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@agentrans/api-remotes",
        "@agentrans/client-locale",
        "@agentrans/client-ui-chat",
        "@agentrans/client-ui-conversation",
        "@agentrans/client-ui-file-actions",
        "@agentrans/client-ui-renderer",
        "@agentrans/client-ui-session",
        "@agentrans/client-ui-workspace",
        "@agentrans/api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/api-remotes": "workspace:*",
    "@agentrans/api-session-controller": "workspace:*",
    "@agentrans/artifact": "workspace:*",
    "@agentrans/client-locale": "workspace:*",
    "@agentrans/client-test-runtime": "workspace:*",
    "@agentrans/client-ui-chat": "workspace:*",
    "@agentrans/client-ui-conversation": "workspace:*",
    "@agentrans/client-ui-file-actions": "workspace:*",
    "@agentrans/client-ui-primitives": "workspace:*",
    "@agentrans/client-ui-renderer": "workspace:*",
    "@agentrans/client-ui-session": "workspace:*",
    "@agentrans/client-ui-slots": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/util-crypto": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@agentrans/client-store": "workspace:*",
    "@agentrans/artifact-branch": "workspace:*",
    "@agentrans/client-ui-workspace": "workspace:*",
    "@agentrans/artifact-export": "workspace:*",
    "@agentrans/artifact-followup": "workspace:*",
    "@agentrans/artifact-runtime": "workspace:*",
    "@agentrans/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
