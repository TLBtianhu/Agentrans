{
  "name": "@agentrans/client-file-upload",
  "description": "Agent-scoped browser file upload, streaming intake, and staged receipt service",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/file-upload"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "agentrans": {
    "client": {
      "inject": [
        "@agentrans/api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "zod": "4.4.3",
    "@agentrans/typert-protocol": "workspace:*",
    "@agentrans/brand": "workspace:*"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/client-connection": "workspace:*",
    "@agentrans/commands": "workspace:*",
    "@agentrans/util-crypto": "workspace:*",
    "@agentrans/api-remotes": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/attachment": "workspace:*"
  }
}
