{
  "name": "@agentrans/client-ui-settings-session-log",
  "description": "General settings control for Session-log upload with DeepSeek API requests",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-session-log"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@agentrans/client-locale",
        "@agentrans/client-ui-settings",
        "@agentrans/client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/api-remotes": "workspace:*",
    "@agentrans/client-locale": "workspace:*",
    "@agentrans/client-store": "workspace:*",
    "@agentrans/client-test-runtime": "workspace:*",
    "@agentrans/client-ui-primitives": "workspace:*",
    "@agentrans/client-ui-renderer": "workspace:*",
    "@agentrans/client-ui-settings": "workspace:*",
    "@agentrans/client-ui-slots": "workspace:*",
    "react": "^18.2.0",
    "@agentrans/client-ui-layout": "workspace:*",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
