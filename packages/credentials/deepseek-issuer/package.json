{
  "name": "@agentrans/deepseek-issuer",
  "description": "One owner for the DeepSeek platform identity: the credential reference, capability classes, and endpoint default each capability uses (identity and defaults only, no requests)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/credentials/deepseek-issuer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~"
  }
}
