{
  "name": "@agentrans/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "agentrans": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@agentrans/cordis-plugin-timer": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/attachment-local": "workspace:*",
    "@agentrans/compaction-basic": "workspace:*",
    "@agentrans/compaction-image-offload": "workspace:*",
    "@agentrans/deepseek-llm-api-extensions": "workspace:*",
    "@agentrans/jobs-local": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/llm-deepseek-api-key": "workspace:*",
    "@agentrans/llm-retry": "workspace:*",
    "@agentrans/mcp-resources": "workspace:*",
    "@agentrans/plugin-package-inventory-deepseek": "workspace:*",
    "@agentrans/sandbox-local": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/sdk-app": "workspace:*",
    "@agentrans/sdk-jsonrpc-server": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-checkpoint-policy": "workspace:*",
    "@agentrans/session-log-deepseek": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/session-title": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/terminal": "workspace:*",
    "@agentrans/terminal-bash": "workspace:*",
    "@agentrans/token-meter": "workspace:*",
    "@agentrans/tool-bash-persistent": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-fs": "workspace:*",
    "@agentrans/tool-pwsh-persistent": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/tool-working-directory": "workspace:*",
    "@agentrans/fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~"
  }
}
