{
  "name": "@agentrans/headless",
  "description": "The dsh one-shot bundle: a direct core Agent/Session runner over dsh-base with no Host, HTTP, or browser layer",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "agentrans": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@agentrans/brand": "workspace:*",
    "@agentrans/cmdline": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-default-model": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-query": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/permission-presets": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/user-approval": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-default-model": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-query": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/permission-presets": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@agentrans/permission-presets": {
      "optional": true
    },
    "@agentrans/sandbox-policy": {
      "optional": true
    },
    "@agentrans/subagent": {
      "optional": true
    }
  }
}
