{
  "name": "@agentrans/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the DeepSeek Harness LLM seam (design-verification twin of dsh-llm-deepseek)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/authorization": "workspace:*",
    "@agentrans/credentials": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/launch-environment": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/timeout": "workspace:*"
  },
  "dependencies": {
    "@agentrans/brand": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/authorization": "workspace:*",
    "@agentrans/credentials": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/http-proxy": "workspace:*",
    "@agentrans/launch-environment": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/llm-deepseek": "workspace:*",
    "@agentrans/llm-deepseek-api-key": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/settings": "workspace:*",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@agentrans/cordis-plugin-loader": {
      "optional": true
    }
  }
