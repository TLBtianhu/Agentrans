{
  "name": "@agentrans/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/llm": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/web": "workspace:*"
  },
  "dependencies": {
    "@agentrans/output-retention": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/spill-local": "workspace:*",
    "@agentrans/spill-policy": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tool-call-timeout-policy": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/web": "workspace:*",
    "@agentrans/web-fetch-http": "workspace:*",
    "@agentrans/web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@agentrans/scope": "workspace:*",
    "@agentrans/token-meter": "workspace:*"
  }
}
