{
  "name": "@agentrans/product-layout",
  "description": "Single-root installation layout, manifests, integration state, and runtime activation for Agentrans",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./launch-context": {
      "types": "./lib/types/launch-context.d.ts",
      "default": "./lib/launch-context.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/launch-context.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~"
  }
}
