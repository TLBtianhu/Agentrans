{
  "name": "@agentrans/pwsh-local",
  "description": "Local PowerShell implementation of the DeepSeek Harness bash executor seam",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/pwsh-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/shell": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/cordis": "workspace:~"
  },
  "dependencies": {
    "@agentrans/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/shell": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/cordis": "workspace:~"
  }
}
