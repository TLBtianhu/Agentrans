{
  "name": "@agentrans/tool-executor-ptc",
  "description": "PTC program execution, tool bindings, and generated SDK prompts",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/tool-executor-ptc"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/ptc-runtime": "workspace:*",
    "@agentrans/sandbox": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/user-approval": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  },
  "dependencies": {
    "@agentrans/brand": "workspace:*",
    "@agentrans/util-values": "workspace:*",
    "@agentrans/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/ptc-runtime": "workspace:*",
    "@agentrans/sandbox": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/user-approval": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  }
}
