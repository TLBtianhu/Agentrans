{
  "name": "@agentrans/tool-todo",
  "description": "Model-facing todo_write tool over the DeepSeek Harness event-sourced session log",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/todo/tool-todo"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentrans/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis-plugin-include": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/user-questions": "workspace:*",
    "@agentrans/cordis": "workspace:~"
  }
}
