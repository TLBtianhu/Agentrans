{
  "name": "@agentrans/working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/working-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/user-approval": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tool-working-directory": "workspace:*",
    "@agentrans/tools": "workspace:*"
  },
  "dependencies": {
    "@agentrans/schemastery": "workspace:~",
    "zod": "^4.4.3"
  }
}
