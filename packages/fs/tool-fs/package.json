    "@agentrans/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@agentrans/attachment": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/sandbox": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/user-approval": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/fs": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/fs-observation-policy": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/llm-deepseek": "workspace:*",
    "@agentrans/llm-deepseek-api-key": "workspace:*",
    "@agentrans/sandbox": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-executor-ptc": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/user-approval": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/ptc-runtime": "workspace:*",
    "@agentrans/fs-sandbox": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  }
