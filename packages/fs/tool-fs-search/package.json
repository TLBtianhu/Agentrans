{
  "name": "@agentrans/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@agentrans/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@agentrans/llm": "workspace:*",
    "@agentrans/output-retention": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/spill": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/agent": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/output-retention": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/spill": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/cordis": "workspace:~",
    "@agentrans/scope": "workspace:*",
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*"
  }
}
