{
  "name": "@agentrans/subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child DeepSeek Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/sdk-client": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/subprocess": "workspace:*"
  },
  "dependencies": {
    "@agentrans/brand": "workspace:*",
    "@agentrans/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-instructions": "workspace:*",
    "@agentrans/app-boot": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/llm-deepseek": "workspace:*",
    "@agentrans/llm-deepseek-api-key": "workspace:*",
    "@agentrans/loader-smoke": "workspace:*",
    "@agentrans/sdk-client": "workspace:*",
    "@agentrans/sdk-protocol": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-checkpoint-policy": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/skill-filesystem": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/subprocess": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/tool-subagent": "workspace:*"
  }
}
