{
  "name": "@agentrans/tool-lsp",
  "description": "Model-facing lsp tool over the DeepSeek Harness LSP capability seam (ctx.lsp) \u2014 one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/llm": "workspace:*",
    "@agentrans/lsp": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  },
  "dependencies": {
    "@agentrans/util-values": "workspace:*",
    "@agentrans/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/fs-local": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/lsp": "workspace:*",
    "@agentrans/lsp-stdio": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/subprocess-local": "workspace:*",
    "@agentrans/system-prompt": "workspace:*",
    "@agentrans/timeout": "workspace:*",
    "@agentrans/tool-call-timeout-policy": "workspace:*",
    "@agentrans/tool-executor-native": "workspace:*",
    "@agentrans/tool-testkit": "workspace:*",
    "@agentrans/tools": "workspace:*",
    "@agentrans/working-directory": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*"
  }
}
