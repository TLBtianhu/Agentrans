{
  "name": "@agentrans/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentrans/brand": "workspace:*",
    "@agentrans/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/cmdline": "workspace:*",
    "@agentrans/commands": "workspace:*",
    "@agentrans/goal": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/schedule": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/sdk-protocol": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/user-approval": "workspace:*",
    "@agentrans/user-questions": "workspace:*",
    "@agentrans/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@agentrans/cordis": "workspace:~",
    "@agentrans/cordis-plugin-loader": "workspace:~",
    "@agentrans/agent": "workspace:*",
    "@agentrans/agent-loop": "workspace:*",
    "@agentrans/agent-loop-testkit": "workspace:*",
    "@agentrans/attachment": "workspace:*",
    "@agentrans/cmdline": "workspace:*",
    "@agentrans/command-compact": "workspace:*",
    "@agentrans/command-goal": "workspace:*",
    "@agentrans/commands": "workspace:*",
    "@agentrans/compaction-basic": "workspace:*",
    "@agentrans/goal": "workspace:*",
    "@agentrans/goal-round-driver": "workspace:*",
    "@agentrans/llm": "workspace:*",
    "@agentrans/llm-deepseek-api-key": "workspace:*",
    "@agentrans/permission-presets": "workspace:*",
    "@agentrans/plan-mode": "workspace:*",
    "@agentrans/sandbox-policy": "workspace:*",
    "@agentrans/schedule": "workspace:*",
    "@agentrans/scope": "workspace:*",
    "@agentrans/sdk-protocol": "workspace:*",
    "@agentrans/session": "workspace:*",
    "@agentrans/session-persistence-jsonl": "workspace:*",
    "@agentrans/session-projection": "workspace:*",
    "@agentrans/shell": "workspace:*",
    "@agentrans/subagent": "workspace:*",
    "@agentrans/token-meter": "workspace:*",
